# =====================================================================
#  İSTEHSALAT (production) .env — NÜMUNƏ
# =====================================================================
#  Serverdə:  cp .env.production.example .env
#             php artisan key:generate
#             php artisan migrate --seed
#
#  Bu fayl NÜMUNƏDİR və depoya düşür — SİRR YAZMAYIN.
#  Doldurulmuş nüsxə `.env` adlanır və `.gitignore`-dadır.
#
#  Doldurduqdan sonra:  php doctor.php
# =====================================================================

APP_NAME="Zarafat Notariat Palatası"

# ƏSAS AÇAR. Bunu «production» etmək tək bir sətir deyil — kod bir neçə
# yerdə ona baxır: simulyasiya ödənişi məcburi bağlanır, seeder «admin12345»
# parolunu rədd edir, `/is/qalereya` marşrutu ümumiyyətlə qeydiyyatdan
# keçmir, və BÖLMƏLƏRİN ilkin dəyəri «yalnız iş qovluğu» olur.
APP_ENV=production

# Xəta izləri ziyarətçiyə göstərilməməlidir.
APP_DEBUG=false

# BOŞ BURAXIN — serverdə `php artisan key:generate` yazır.
# Açarı bir dəfə təyin edəndən sonra DƏYİŞMƏYİN: sessiyalar və şifrələnmiş
# cookie-lər onunla bağlıdır.
APP_KEY=

# QR KODLAR BU ÜNVANA BAĞLANIR. Domen dəyişsə, artıq dərc olunmuş
# sənədlərin QR-ları köhnə ünvanı göstərməyə davam edər.
# `https` ilə başlayanda sessiya və qonaq cookie-ləri avtomatik `secure` olur.
APP_URL=https://SIZIN-DOMEN

APP_LOCALE=az
APP_TIMEZONE=Asia/Baku

LOG_CHANNEL=stack
# İstehsalatda `debug` səviyyəsi jurnalı doldurur və istifadəçi məlumatı
# yazır. AI çağırışlarının ölçüləri `info` səviyyəsindədir.
LOG_LEVEL=info

# ---- Verilənlər bazası ----
# SQLite kifayət edir və depo onunla işlənib. Fayl PUBLIC KÖKDƏN KƏNARDA
# olmalıdır (`database/` elə oradadır) və veb server ona yazma icazəsi
# verməlidir.
DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/zarafat/backend-php/database/database.sqlite

# MySQL istəsəniz:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=zarafat
# DB_USERNAME=zarafat
# DB_PASSWORD=

# ---- Sessiya, keş, növbə ----
# CACHE_STORE=database YÜK DAŞIYIR: bütün `throttle:*` limitləri keş
# anbarında işləyir. `cache` cədvəli miqrasiya ilə gəlir; anbar dəyişsə və
# ya cədvəl itsə, HƏR limit səssizcə işləməyi dayandırır.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- Ödəniş ----
# `simulation` ödənişi dərhal «keçmiş» sayır və pulsuz kredit yazır.
# İstehsalatda kod onu onsuz da rədd edir (`PaymentService::provider()`
# istisna atır), amma açıq yazmaq niyyəti sənədləşdirir.
PAYMENT_PROVIDER=epoint
ALLOW_SIMULATED_PAYMENTS=false

EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
EPOINT_ENDPOINT=https://epoint.az/api/1/request

# ---- İlk admin ----
# «admin12345» İSTEHSALATDA QƏBUL EDİLMİR — seeder onu rədd edir.
# Parolu BOŞ buraxsanız təsadüfi güclü parol yaradılır və seed zamanı
# bir dəfə ekrana yazılır; ən təhlükəsiz yol budur.
# Parol yalnız hesab İLK DƏFƏ yaradılanda tətbiq olunur — təkrar seed
# mövcud parolu sıfırlamır.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Bölmələr: hansı məhsul canlıdır ----
# BURADA HEÇ NƏ YAZMAQ LAZIM DEYİL. `APP_ENV=production` olduğu üçün ilkin
# dəyər özü yalnız iş qovluğunu açıq saxlayır, ana səhifə isə /is olur:
#
#     /                → 302 /is
#     /is  /is/balans  → açıq
#     /devetname  /kabinet  /r/{nömrə}  /api/catalog  → 404
#
# Sonradan idarə panelindən (/admin/parametrler) açıb-bağlaya bilərsiniz;
# oradakı seçim həm bu fayldan, həm də ilkin dəyərdən üstündür.
# Bir bölməni elə indidən açmaq üçün:
# BOLME_ZARAFAT=true
# BOLME_DEVET=true
# BOLME_ANA=zarafat

# ---- Google ilə giriş ----
# Açarlar YALNIZ burada saxlanılır, bazada heç vaxt — baza ehtiyat nüsxəsi
# və «Kataloqu ixrac et» onları özü ilə aparardı.
# Boş qoysanız Google düyməsi ümumiyyətlə render olunmur; sayt adi qeydiyyat
# və qonaq rejimi ilə işləməyə davam edir.
#
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID →
# Web application. «Authorized redirect URIs» sahəsinə DƏQİQ bunu yazın:
#     https://SIZIN-DOMEN/giris/google/cavab
# Google ünvanı HƏRFİ müqayisə edir — `www` olan və olmayan variant onun
# üçün fərqli ünvandır, ikisini də istifadə edirsinizsə ikisini də yazın.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT=https://SIZIN-DOMEN/giris/google/cavab

# ---- AI köməkçisi (könüllü) ----
# Boş qoysanız idarə panelindəki «AI ilə hazırla» və «AI ilə iş qur»
# bölmələri görünmür, qalan hər şey işləyir. Hər çağırış real pul xərcləyir.
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini

# ---- Sosial kimlik kartı (könüllü) ----
# Profil məlumatının avtomatik doldurulması. Söndürüləndə bölmə işləməyə
# davam edir — sahələr boş qalır və istifadəçi özü doldurur.
# Hostinq IP-lərindən bu sorğular tez-tez bağlanır, ona görə istehsalatda
# söndürmək normal seçimdir.
# SOSIAL_FETCH=false

# ---- Moderasiya ----
# Qadağan söz siyahısı. İdarə panelindən də redaktə olunur və oradakı
# dəyər bundan üstündür.
BANNED_WORDS=
