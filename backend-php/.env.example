APP_NAME="Zarafat Notariat Palatası"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=az
APP_TIMEZONE=Asia/Baku

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Verilənlər bazası ----
# Lokal üçün ən sadəsi SQLite:
DB_CONNECTION=sqlite
# DB_DATABASE=/tam/yol/database/database.sqlite   # boş buraxsanız database/database.sqlite istifadə olunur

# İstehsalat üçün MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=zarafat
# DB_USERNAME=zarafat
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- Ödəniş ----
# DİQQƏT: `simulation` ödənişi dərhal «keçmiş» sayır və pulsuz kredit yazır.
# Yalnız lokal iş üçündür — APP_ENV=production olduqda hər ikisi məcburi bağlanır.
PAYMENT_PROVIDER=simulation
ALLOW_SIMULATED_PAYMENTS=true

EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
EPOINT_ENDPOINT=https://epoint.az/api/1/request

# ---- AI şablon köməkçisi (OpenAI) ----
# Admin paneldəki «AI ilə hazırla» bölməsini açır. Açar QƏSDƏN yalnız burada
# saxlanılır — bazaya yazılsaydı, kataloq ixracı və baza ehtiyat nüsxəsi ilə
# birlikdə yayılardı (Epoint açarları ilə eyni qayda).
# Boş qoysanız köməkçi görünmür, qalan hər şey əvvəlki kimi işləyir.
OPENAI_API_KEY=

# Default model. Admin paneldən (/admin/parametrler) dəyişilə bilər və
# oradakı dəyər bundan üstündür — yeni model üçün deploy gözləmək lazım deyil.
AI_MODEL=gpt-5.4-mini

# AI_ENABLED=false — açar olsa belə köməkçini tamam bağlayır.
# AI_TIMEOUT=90
# AI_MAX_OUTPUT_TOKENS=6000
# AI_TEMPERATURE=0.8            (bəzi yeni modellər qəbul etmir — o zaman avtomatik atılır)
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions

# ---- Sosial kimlik kartı (TikTok · Instagram) ----
# Profil məlumatının AVTOMATİK doldurulması. Söndürüləndə bölmə işləməyə davam
# edir — sahələr sadəcə boş qalır və istifadəçi özü doldurur.
#
# DİQQƏT: bu «ən yaxşı cəhd»dir, zəmanət deyil. TikTok açarsız oEmbed-dən yalnız
# GÖRÜNƏN ADI verir; Instagram-ın rəsmi yolu 04.12.2024-dən yoxdur və işlədilən
# endpoint qeyri-rəsmidir — hostinq IP-lərindən tez-tez bağlanır.
# SOSIAL_FETCH=false
# SOSIAL_TIMEOUT=6
# SOSIAL_CACHE_MINUTES=60

# ---- İş qovluğu (onlayn detektiv bölməsi) ----
# Ayrı domenə keçsə: DOSSIER_URL=https://... — kodda heç nə dəyişmir.
# DOSSIER_URL=
# Ödənişli qovluqların qiyməti. Giriş qovluğu seed-də 0-dır və pulsuz qalır.
# DOSSIER_PRICE_CREDITS=5
# Yekun rəy üçün cəhd sayı. Bitəndə izah açılır, sertifikat verilmir.
# DOSSIER_ATTEMPTS=3

# ---- Moderasiya ----
BANNED_WORDS=

# ---- İlk admin (php artisan db:seed zamanı yaradılır) ----
# Parol YALNIZ hesab ilk dəfə yaradılanda tətbiq olunur — təkrar seed onu sıfırlamır.
# Boş buraxsanız təsadüfi güclü parol yaradılır və bir dəfə ekrana yazılır.
# İstehsalatda «admin12345» qəbul edilmir.
ADMIN_EMAIL=admin@zarafat.az
ADMIN_PASSWORD=admin12345

# ---- Sessiya ----
# APP_URL https ilə başlayırsa sessiya cookie-si avtomatik `secure` olur.
# Ehtiyac olarsa əl ilə də təyin edə bilərsiniz:
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

# ---- Google ilə giriş ----
# Açarlar YALNIZ burada saxlanılır, bazada heç vaxt — `OPENAI_API_KEY` ilə
# eyni qayda. Boş buraxsanız Google düyməsi ümumiyyətlə render olunmur və
# sayt adi qeydiyyat + qonaq rejimi ilə işləməyə davam edir.
#
# Google Cloud Console → «APIs & Services» → «Credentials» →
#   «Create credentials» → «OAuth client ID» → «Web application».
# Authorized redirect URIs sahəsinə DƏQİQ bu ünvanı yazın:
#   http://localhost:8000/giris/google/cavab
#   http://127.0.0.1:8000/giris/google/cavab      ← ikisi də lazımdır
#   https://SİZİN-DOMEN/giris/google/cavab
# Google ünvanı HƏRFİ müqayisə edir; `localhost` ilə `127.0.0.1` onun üçün
# fərqli ünvandır və yalnız birini yazsanız `redirect_uri_mismatch` alarsınız.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cavab ünvanını əl ilə təyin etmək (adətən lazım deyil — cari host götürülür):
# GOOGLE_REDIRECT=https://SİZİN-DOMEN/giris/google/cavab

# ---- Bölmələr: hansı məhsul canlıdır ----
# Sayt üç ayrı məhsul daşıyır və hazır olmayanı bağlamaq olar — bağlı
# bölmənin BÜTÜN ünvanları 404 qaytarır (admin üçün açıq qalır).
#
# İSTEHSALATDA (APP_ENV=production) HEÇ NƏ YAZMAQ LAZIM DEYİL:
# ilkin dəyər özü yalnız iş qovluğunu açıq saxlayır, ana səhifə isə /is olur.
# Bu, qəsdəndir — hazır olmayan məhsulun canlı qalması «kimsə parametri
# yazmağı unudarsa» halına buraxılmamalıdır.
#
# Üstünlük sırası:  idarə paneli (settings)  >  buradakı BOLME_*  >  ilkin dəyər.
# Yəni paneldən bir dəfə keçid basıldısa, artıq o hökm sürür.
#
# Yerli mühitdə hər üçü açıqdır (test dəsti onların ünvanlarını gəzir).
# Yerli maşında istehsalat vəziyyətini görmək üçün:
# BOLME_ZARAFAT=false
# BOLME_DEVET=false
# BOLME_ANA=is
#
# DİQQƏT: zarafat bağlananda /r/{nömrə} də bağlanır, yəni dərc olunmuş
# sənədlərin QR ünvanları 404 verir. Nəzərdən qaçmış nəticə deyil —
# məhsul gizlədiləndə onun artefaktları da gizlənməlidir.
