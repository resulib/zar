APP_NAME="Zarafat Notariat Palatası"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=az
APP_TIMEZONE=Asia/Baku

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Verilənlər bazası ----
# Lokal üçün ən sadəsi SQLite:
DB_CONNECTION=sqlite
# DB_DATABASE=/tam/yol/database/database.sqlite   # boş buraxsanız database/database.sqlite istifadə olunur

# İstehsalat üçün MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=zarafat
# DB_USERNAME=zarafat
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- Ödəniş ----
# DİQQƏT: `simulation` ödənişi dərhal «keçmiş» sayır və pulsuz kredit yazır.
# Yalnız lokal iş üçündür — APP_ENV=production olduqda hər ikisi məcburi bağlanır.
PAYMENT_PROVIDER=simulation
ALLOW_SIMULATED_PAYMENTS=true

EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
EPOINT_ENDPOINT=https://epoint.az/api/1/request

# ---- AI şablon köməkçisi (OpenAI) ----
# Admin paneldəki «AI ilə hazırla» bölməsini açır. Açar QƏSDƏN yalnız burada
# saxlanılır — bazaya yazılsaydı, kataloq ixracı və baza ehtiyat nüsxəsi ilə
# birlikdə yayılardı (Epoint açarları ilə eyni qayda).
# Boş qoysanız köməkçi görünmür, qalan hər şey əvvəlki kimi işləyir.
OPENAI_API_KEY=

# Default model. Admin paneldən (/admin/parametrler) dəyişilə bilər və
# oradakı dəyər bundan üstündür — yeni model üçün deploy gözləmək lazım deyil.
AI_MODEL=gpt-5.5-mini

# AI_ENABLED=false — açar olsa belə köməkçini tamam bağlayır.
# AI_TIMEOUT=90
# AI_MAX_OUTPUT_TOKENS=6000
# AI_TEMPERATURE=0.8            (bəzi yeni modellər qəbul etmir — o zaman avtomatik atılır)
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions

# ---- Moderasiya ----
BANNED_WORDS=

# ---- İlk admin (php artisan db:seed zamanı yaradılır) ----
# Parol YALNIZ hesab ilk dəfə yaradılanda tətbiq olunur — təkrar seed onu sıfırlamır.
# Boş buraxsanız təsadüfi güclü parol yaradılır və bir dəfə ekrana yazılır.
# İstehsalatda «admin12345» qəbul edilmir.
ADMIN_EMAIL=admin@zarafat.az
ADMIN_PASSWORD=admin12345

# ---- Sessiya ----
# APP_URL https ilə başlayırsa sessiya cookie-si avtomatik `secure` olur.
# Ehtiyac olarsa əl ilə də təyin edə bilərsiniz:
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
