# ---- server ----
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000     # QR kod və callback bu ünvana bağlanır
FRONTEND_DIR=../frontend
DB_PATH=./data/zarafat.db
COOKIE_SECRET=uzun-tesadufi-deyer-yazin
LOG_LEVEL=info

# ---- ödəniş ----
PAYMENT_PROVIDER=simulation          # simulation | epoint
ALLOW_SIMULATED_PAYMENTS=true        # istehsalatda false edin

# Epoint (PAYMENT_PROVIDER=epoint olduqda)
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
EPOINT_ENDPOINT=https://epoint.az/api/1/request

# ---- moderasiya ----
ADMIN_TOKEN=admin-token-deyisin
BANNED_WORDS=                        # vergüllə ayrılmış qadağan siyahısı
